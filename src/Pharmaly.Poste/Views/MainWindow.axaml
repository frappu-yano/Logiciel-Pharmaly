<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pharmaly.Poste.ViewModels"
        x:Class="Pharmaly.Poste.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Pharmaly Gestion"
        Width="1180" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid>
  <DockPanel x:Name="WorkArea" IsVisible="{Binding Session.IsWork}">

    <!-- Bandeau -->
    <Border DockPanel.Dock="Top" Background="{StaticResource InkBrush}" Padding="20,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Background="{StaticResource TurquoiseBrush}" CornerRadius="6" Width="30" Height="30">
            <TextBlock Text="P" FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Pharmaly Gestion" FontSize="18" FontWeight="SemiBold" Foreground="White"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock x:Name="EmployeeLabel" Text="{Binding Session.EmployeeName}" Foreground="White" FontWeight="Medium"
                     VerticalAlignment="Center" />
          <Button x:Name="LockButton" Classes="quiet" Content="Verrouiller (F12)" Padding="12,6" MinHeight="34"
                  Command="{Binding LockCommand}" Focusable="False" />
        </StackPanel>
        <Border Grid.Column="2" Classes="status" Classes.connected="{Binding Status.IsConnected}">
          <TextBlock x:Name="StatusLabel" Text="{Binding Status.StatusText}" FontSize="13" FontWeight="Medium"
                     Foreground="{StaticResource InkBrush}" />
        </Border>
      </Grid>
    </Border>

    <!-- Navigation entre modules : un bouton par module visible, avec sa touche -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1" Padding="20,8">
      <ItemsControl x:Name="ModuleBar" ItemsSource="{Binding Modules}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModuleEntryViewModel">
            <Button Classes="nav" Classes.current="{Binding IsCurrent}" Command="{Binding OpenCommand}" Focusable="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="key">
                  <TextBlock Text="{Binding ShortcutLabel}" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Grid>
      <!-- Vue du module affiché, placée par le code à chaque changement de module -->
      <ContentControl x:Name="ModuleHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <Border x:Name="NoModulePanel" Classes="card empty" IsVisible="{Binding HasNoModule}">
        <StackPanel Spacing="8">
          <TextBlock Classes="emptyState" Text="Aucun module n'est accessible avec vos droits" />
          <TextBlock Classes="label" TextAlignment="Center" TextWrapping="Wrap"
                     Text="Demandez à un administrateur de vous attribuer des droits, puis verrouillez le poste (F12) et identifiez-vous à nouveau." />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>

  <!-- Niveau 1 : compte de caisse du poste -->
  <Border x:Name="PosteSignInPanel" DataContext="{Binding Session}" x:DataType="vm:SessionViewModel"
          IsVisible="{Binding IsPosteSignIn}" Background="{StaticResource BeigeBrush}">
    <Border Classes="card" Width="420" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <TextBlock Text="Pharmaly Gestion" FontSize="24" FontWeight="Bold" />
        <TextBlock Classes="label" TextWrapping="Wrap"
                   Text="Connectez ce poste avec son compte de caisse. Cette étape n'est demandée qu'une fois par poste." />
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="Compte de caisse" />
          <TextBox x:Name="RegisterLoginBox" Text="{Binding RegisterLogin}" FontSize="17" Padding="12,10" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="Mot de passe" />
          <TextBox x:Name="RegisterPasswordBox" Text="{Binding RegisterPassword}" PasswordChar="●" FontSize="17"
                   Padding="12,10" />
        </StackPanel>
        <TextBlock x:Name="PosteErrorLabel" Text="{Binding ErrorMessage}" Foreground="#9A2B12" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Classes="primary" Content="Connecter le poste (Entrée)" Command="{Binding SignInPosteCommand}"
                IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>

  <!-- Niveau 2 : identification de l'employé -->
  <Border x:Name="EmployeeSignInPanel" DataContext="{Binding Session}" x:DataType="vm:SessionViewModel"
          IsVisible="{Binding IsEmployeeSignIn}" Background="{StaticResource BeigeBrush}">
    <Border Classes="card" Width="420" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <TextBlock Text="Identification" FontSize="24" FontWeight="Bold" />
        <TextBlock Classes="label" Text="{Binding RegisterLabel}"
                   IsVisible="{Binding RegisterLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="Matricule" />
          <TextBox x:Name="EmployeeNumberBox" Text="{Binding EmployeeNumber}" FontSize="20" Padding="12,10" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="Code personnel" />
          <TextBox x:Name="EmployeeSecretBox" Text="{Binding EmployeeSecret}" PasswordChar="●" FontSize="20"
                   Padding="12,10" />
        </StackPanel>
        <TextBlock x:Name="EmployeeErrorLabel" Text="{Binding ErrorMessage}" Foreground="#9A2B12" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Classes="primary" Content="S'identifier (Entrée)" Command="{Binding SignInEmployeeCommand}"
                IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</Window>
