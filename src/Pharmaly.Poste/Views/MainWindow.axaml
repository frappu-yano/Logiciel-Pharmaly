<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pharmaly.Poste.ViewModels"
        xmlns:contracts="using:Pharmaly.Contracts"
        xmlns:views="using:Pharmaly.Poste.Views"
        x:Class="Pharmaly.Poste.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Pharmaly Gestion"
        Width="1180" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid>
  <DockPanel x:Name="WorkArea">

    <!-- Bandeau -->
    <Border DockPanel.Dock="Top" Background="{StaticResource InkBrush}" Padding="20,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Background="{StaticResource TurquoiseBrush}" CornerRadius="6" Width="30" Height="30">
            <TextBlock Text="P" FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Pharmaly Gestion" FontSize="18" FontWeight="SemiBold" Foreground="White"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock x:Name="EmployeeLabel" Foreground="White" FontWeight="Medium" VerticalAlignment="Center" />
          <Button x:Name="LockButton" Classes="quiet" Content="Verrouiller (F12)" Padding="12,6" MinHeight="34" />
        </StackPanel>
        <Border Grid.Column="2" Classes="status" Classes.connected="{Binding IsConnected}">
          <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" FontSize="13" FontWeight="Medium"
                     Foreground="{StaticResource InkBrush}" />
        </Border>
      </Grid>
    </Border>

    <!-- Mesures -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,10">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="24">
          <TextBlock x:Name="MemoryLabel" Text="{Binding MemoryText}" Classes="label" />
          <TextBlock Text="{Binding SearchSpeedText}" Classes="label" />
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="BenchmarkLabel" Text="{Binding BenchmarkText}" FontSize="13"
                   FontWeight="Medium" Margin="0,4,0,0" TextWrapping="Wrap" />
        <Button Grid.Column="1" Grid.RowSpan="2" Classes="quiet" Content="Lancer l'essai de rapidité (F9)"
                Command="{Binding RunBenchmarkCommand}" IsEnabled="{Binding !IsBenchmarkRunning}"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Avertissement -->
    <Border DockPanel.Dock="Top" Background="{StaticResource PeachSoftBrush}" Padding="20,8">
      <TextBlock FontSize="13"
                 Text="Version d'essai — données fictives. Aucune vente n'est enregistrée et le stock n'est pas modifié." />
    </Border>

    <Grid ColumnDefinitions="*,360" Margin="20" ColumnSpacing="16">

      <!-- Recherche et lignes -->
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Scanner un code-barres ou saisir un nom, puis Entrée" />
            <TextBox x:Name="SearchBox" Text="{Binding Query}" FontSize="18" Padding="12,10"
                     PlaceholderText="Code-barres, nom ou code interne" />
            <TextBlock Text="{Binding Notice}" Foreground="#9A4A12" FontSize="13"
                       IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="card" Padding="0" IsVisible="{Binding HasResults}" MaxHeight="230">
          <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="contracts:ProductSummary">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Barcode}" Classes="label" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding SalePrice, Converter={x:Static views:MoneyConverter.Instance}}"
                             FontWeight="SemiBold" MinWidth="110" TextAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Lignes" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="quiet" Content="−" Command="{Binding DecreaseSelectedLineCommand}"
                          ToolTip.Tip="Diminuer la quantité (touche −)" />
                  <Button Classes="quiet" Content="+" Command="{Binding IncreaseSelectedLineCommand}"
                          ToolTip.Tip="Augmenter la quantité (touche +)" />
                  <Button Classes="quiet" Content="Retirer la ligne" Command="{Binding RemoveSelectedLineCommand}"
                          ToolTip.Tip="Touche Suppr" />
                </StackPanel>
              </Grid>
            </Border>
            <ListBox x:Name="LinesList" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                     Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SaleLineViewModel">
                  <Grid ColumnDefinitions="*,120,70,130" ColumnSpacing="12">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding UnitPriceText}" Classes="label" TextAlignment="Right"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='× {0}'}" FontWeight="SemiBold"
                               TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{Binding LineTotalText}" FontWeight="SemiBold"
                               TextAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Total -->
      <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="14">
          <TextBlock Classes="label" Text="{Binding ArticleCountText}" />
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="Total" />
            <TextBlock x:Name="TotalLabel" Text="{Binding TotalText}" FontSize="34" FontWeight="Bold" />
          </StackPanel>
          <Button Classes="primary" Content="Vider les lignes (Échap)" Command="{Binding ClearLinesCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Border Background="{StaticResource TurquoiseSoftBrush}" CornerRadius="8" Padding="12">
            <TextBlock FontSize="13" TextWrapping="Wrap"
                       Text="Entrée : ajouter · ↓ ↑ : choisir un résultat · + − : quantité · Suppr : retirer · F9 : essai de rapidité" />
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>

  <!-- Niveau 1 : compte de caisse du poste -->
  <Border x:Name="PosteSignInPanel" x:DataType="vm:SessionViewModel" IsVisible="{Binding IsPosteSignIn}"
          Background="{StaticResource BeigeBrush}">
    <Border Classes="card" Width="420" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <TextBlock Text="Pharmaly Gestion" FontSize="24" FontWeight="Bold" />
        <TextBlock Classes="label" TextWrapping="Wrap"
                   Text="Connectez ce poste avec son compte de caisse. Cette étape n'est demandée qu'une fois par poste." />
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="Compte de caisse" />
          <TextBox x:Name="RegisterLoginBox" Text="{Binding RegisterLogin}" FontSize="17" Padding="12,10" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="Mot de passe" />
          <TextBox x:Name="RegisterPasswordBox" Text="{Binding RegisterPassword}" PasswordChar="●" FontSize="17"
                   Padding="12,10" />
        </StackPanel>
        <TextBlock x:Name="PosteErrorLabel" Text="{Binding ErrorMessage}" Foreground="#9A2B12" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Classes="primary" Content="Connecter le poste (Entrée)" Command="{Binding SignInPosteCommand}"
                IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>

  <!-- Niveau 2 : identification de l'employé -->
  <Border x:Name="EmployeeSignInPanel" x:DataType="vm:SessionViewModel" IsVisible="{Binding IsEmployeeSignIn}"
          Background="{StaticResource BeigeBrush}">
    <Border Classes="card" Width="420" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <TextBlock Text="Identification" FontSize="24" FontWeight="Bold" />
        <TextBlock Classes="label" Text="{Binding RegisterLabel}"
                   IsVisible="{Binding RegisterLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="Matricule" />
          <TextBox x:Name="EmployeeNumberBox" Text="{Binding EmployeeNumber}" FontSize="20" Padding="12,10" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="Code personnel" />
          <TextBox x:Name="EmployeeSecretBox" Text="{Binding EmployeeSecret}" PasswordChar="●" FontSize="20"
                   Padding="12,10" />
        </StackPanel>
        <TextBlock x:Name="EmployeeErrorLabel" Text="{Binding ErrorMessage}" Foreground="#9A2B12" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Classes="primary" Content="S'identifier (Entrée)" Command="{Binding SignInEmployeeCommand}"
                IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</Window>
