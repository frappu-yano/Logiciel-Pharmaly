<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pharmaly.Poste.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <FontFamily x:Key="PharmalyFont">avares://PharmalyGestion/Assets/Fonts#Poppins</FontFamily>
    <!-- Charte Pharmaly -->
    <Color x:Key="TurquoiseColor">#2ECAC8</Color>
    <Color x:Key="PeachColor">#F5A97A</Color>
    <Color x:Key="BeigeColor">#FAF6EF</Color>
    <Color x:Key="InkColor">#111111</Color>
    <SolidColorBrush x:Key="TurquoiseBrush" Color="{StaticResource TurquoiseColor}" />
    <SolidColorBrush x:Key="TurquoiseSoftBrush" Color="#D9F5F4" />
    <SolidColorBrush x:Key="PeachBrush" Color="{StaticResource PeachColor}" />
    <SolidColorBrush x:Key="PeachSoftBrush" Color="#FDEBDD" />
    <SolidColorBrush x:Key="BeigeBrush" Color="{StaticResource BeigeColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="#5C5A55" />
    <SolidColorBrush x:Key="LineBrush" Color="#E4DDD0" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <!-- Couleur d'accent du thème (cases cochées, champ actif) : le turquoise de la charte, coche noire. -->
    <Color x:Key="SystemAccentColor">#2ECAC8</Color>
    <Color x:Key="SystemAccentColorDark1">#27B3B1</Color>
    <Color x:Key="SystemAccentColorDark2">#1F9C9A</Color>
    <Color x:Key="SystemAccentColorDark3">#178583</Color>
    <Color x:Key="SystemAccentColorLight1">#55D5D3</Color>
    <Color x:Key="SystemAccentColorLight2">#82E0DE</Color>
    <Color x:Key="SystemAccentColorLight3">#ABEAE9</Color>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource InkColor}" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource PharmalyFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Background" Value="{StaticResource BeigeBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.status">
      <Setter Property="Background" Value="{StaticResource PeachBrush}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.status.connected">
      <Setter Property="Background" Value="{StaticResource TurquoiseBrush}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,11" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource TurquoiseSoftBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource TurquoiseBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="46" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="MinWidth" Value="46" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Barre de navigation entre modules -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="12,0,16,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav.current">
      <Setter Property="Background" Value="{StaticResource TurquoiseBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource TurquoiseBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource TurquoiseBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource TurquoiseBrush}" />
    </Style>
    <Style Selector="Border.key">
      <Setter Property="Background" Value="{StaticResource BeigeBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- État vide d'un module ou d'une liste -->
    <Style Selector="Border.empty">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="40,32" />
      <Setter Property="MaxWidth" Value="560" />
    </Style>
    <Style Selector="TextBlock.emptyTitle">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.emptyState">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Administration -->
    <Style Selector="TextBlock.groupTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.state">
      <Setter Property="Background" Value="{StaticResource PeachSoftBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.state.active">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource TurquoiseBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.state.self">
      <Setter Property="Background" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="Border.message">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.message.error">
      <Setter Property="Background" Value="{StaticResource PeachSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PeachBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.message.info">
      <Setter Property="Background" Value="{StaticResource TurquoiseSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource TurquoiseBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Application.Styles>
</Application>
