<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Pharmaly.Poste.Modules.Cash"
             xmlns:sales="using:Pharmaly.Poste.Modules.Sales"
             xmlns:contracts="using:Pharmaly.Contracts"
             x:Class="Pharmaly.Poste.Modules.Cash.CashView"
             x:DataType="local:CashViewModel"
             Focusable="True">
  <UserControl.Styles>
    <Style Selector="TextBlock.number">
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFeatures" Value="tnum" />
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.stepTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.stepError">
      <Setter Property="Foreground" Value="#9A2B12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontFeatures" Value="tnum" />
    </Style>
    <Style Selector="TextBlock.huge">
      <Setter Property="FontSize" Value="46" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontFeatures" Value="tnum" />
    </Style>
    <Style Selector="TextBlock.indicator">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontFeatures" Value="tnum" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.pendingCard">
      <Setter Property="Foreground" Value="#9A2B12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.pay">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.step">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="16,0" />
    </Style>
    <Style Selector="Button.refuse">
      <Setter Property="Background" Value="{StaticResource PeachBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,12" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.check">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.check.checked">
      <Setter Property="Background" Value="{StaticResource TurquoiseBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource TurquoiseBrush}" />
    </Style>
    <Style Selector="Border.warning">
      <Setter Property="Background" Value="{StaticResource PeachSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PeachBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Padding" Value="14,8" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Onglets -->
    <Grid Margin="16,10,16,0" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
      <Button x:Name="ReceivablesTabButton" Classes="nav tab" Classes.current="{Binding IsReceivablesTab}" Content="Impayés"
              Command="{Binding ShowTabCommand}" CommandParameter="{x:Static local:CashTab.Receivables}" />
      <Button Grid.Column="1" x:Name="SessionTabButton" Classes="nav tab" Classes.current="{Binding IsSessionTab}"
              Content="Session de caisse" Command="{Binding ShowTabCommand}" CommandParameter="{x:Static local:CashTab.Session}" />
      <Button Grid.Column="2" x:Name="ClosingTabButton" Classes="nav tab" Classes.current="{Binding IsClosingTab}" Content="Clôture"
              Command="{Binding ShowTabCommand}" CommandParameter="{x:Static local:CashTab.Closing}" />
      <TextBlock Grid.Column="3" Classes="label" Text="Ctrl+Tab : onglet suivant · Ctrl+R : relire" VerticalAlignment="Center"
                 HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
    </Grid>

    <!-- ==================== Impayés ==================== -->
    <Grid Grid.Row="1" x:Name="ReceivablesPanel" IsVisible="{Binding IsReceivablesTab}">

      <Border Classes="card empty" IsVisible="{Binding !Rights.CanViewReceivables}">
        <StackPanel Spacing="8">
          <TextBlock Classes="emptyTitle" Text="Impayés" />
          <TextBlock x:Name="NoReceivablesRightLabel" Classes="emptyState" Text="{x:Static local:CashViewModel.NoReceivablesViewRight}" />
        </StackPanel>
      </Border>

      <DockPanel Margin="16,10,16,12" IsVisible="{Binding Rights.CanViewReceivables}">

        <!-- Indicateurs, toujours visibles -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*" ColumnSpacing="10" Margin="0,0,0,8">
          <Border Classes="card tile">
            <StackPanel>
              <TextBlock Classes="label" Text="Impayés ouverts" />
              <TextBlock x:Name="OpenAmountLabel" Classes="indicator" Text="{Binding OpenAmountText}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card tile">
            <StackPanel>
              <TextBlock Classes="label" Text="Tickets impayés" />
              <TextBlock x:Name="OpenCountLabel" Classes="indicator" Text="{Binding OpenCountText}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card tile">
            <StackPanel>
              <TextBlock Classes="label" Text="Total des créances" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="TotalAmountLabel" Classes="indicator" Text="{Binding TotalAmountText}" />
            </StackPanel>
          </Border>
          <Button Grid.Column="3" x:Name="SettledHistoryButton" Classes="quiet" Padding="14,6" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" Focusable="False" Command="{Binding ShowSettledHistoryCommand}"
                  ToolTip.Tip="Historique des créances soldées">
            <StackPanel>
              <TextBlock Classes="label" Text="Soldées — voir l'historique" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="SettledAmountLabel" Classes="indicator" Text="{Binding SettledAmountText}" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- Caisse fermée -->
        <Border DockPanel.Dock="Top" x:Name="CashClosedWarning" Classes="warning" Margin="0,0,0,8" Padding="12,8"
                IsVisible="{Binding IsCashClosedWarning}">
          <TextBlock Text="{x:Static local:CashViewModel.CashClosedMessage}" TextWrapping="Wrap" FontWeight="Medium" />
        </Border>

        <!-- Recherche et filtres -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="12,8" Margin="0,0,0,8">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,112,Auto,112" ColumnSpacing="8">
            <TextBox x:Name="SearchBox" Text="{Binding SearchText}" FontSize="16" Padding="10,8"
                     PlaceholderText="Scanner le ticket, n° de ticket ou nom du client, puis Entrée" />
            <Border Grid.Column="1" x:Name="CustomerFilterChip" Classes="state active" Padding="10,2,2,2"
                    IsVisible="{Binding HasCustomerFilter}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="CustomerFilterLabel" Text="{Binding CustomerFilterText}" VerticalAlignment="Center" FontSize="13"
                           FontWeight="SemiBold" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                <Button Content="✕" Padding="8,2" MinHeight="0" Background="Transparent" Focusable="False"
                        Command="{Binding ClearCustomerFilterCommand}" ToolTip.Tip="Tous les clients" />
              </StackPanel>
            </Border>
            <ComboBox Grid.Column="2" x:Name="StatusBox" ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding SelectedStatus}"
                      MinWidth="110" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Classes="label" Text="du" VerticalAlignment="Center" />
            <TextBox Grid.Column="4" x:Name="FromBox" Text="{Binding FromText}" PlaceholderText="jj/mm/aaaa" Padding="8,8" />
            <TextBlock Grid.Column="5" Classes="label" Text="au" VerticalAlignment="Center" />
            <TextBox Grid.Column="6" x:Name="ToBox" Text="{Binding ToText}" PlaceholderText="jj/mm/aaaa" Padding="8,8" />
          </Grid>
        </Border>

        <!-- Sélection, règlement et messages -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
          <Border Classes="message error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock x:Name="ErrorLabel" Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontWeight="Medium" />
          </Border>
          <Border Classes="message info" IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock x:Name="InfoLabel" Text="{Binding InfoMessage}" TextWrapping="Wrap" FontWeight="Medium" />
          </Border>

          <Border x:Name="SelectionBar" Classes="card" Padding="14,8" IsVisible="{Binding CanSettle}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
              <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="SelectionCustomerLabel" Text="{Binding SelectionCustomerText}" FontWeight="SemiBold" FontSize="16"
                           TextTrimming="CharacterEllipsis" IsVisible="{Binding HasSelection}" />
                <TextBlock x:Name="SelectionTicketsLabel" Classes="label" Text="{Binding SelectionTicketsText}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                <TextBlock Classes="label" Text="À ENCAISSER" HorizontalAlignment="Right" />
                <TextBlock x:Name="SelectionTotalLabel" Classes="big number" FontSize="26" Text="{Binding SelectionTotalText}" />
              </StackPanel>
              <Button Grid.Column="2" x:Name="CashButton" Classes="primary pay" Command="{Binding BeginCashCommand}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Border Classes="key" MinWidth="34">
                    <TextBlock x:Name="CashKeyLabel" Text="{Binding CashKeyLabel}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="ESPÈCES" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button Grid.Column="3" x:Name="CardButton" Classes="quiet pay" Command="{Binding BeginCardCommand}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Border Classes="key" MinWidth="34">
                    <TextBlock x:Name="CardKeyLabel" Text="{Binding CardKeyLabel}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="TPE" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Classes="label" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Entrée : chercher · ↑ ↓ : ligne · Espace : cocher · F7 : ouverts / soldés / tous · Échap : effacer la recherche ou le client" />
            <Button Grid.Column="1" x:Name="PendingAnswerButton" Classes="quiet" Focusable="False"
                    Content="Réponse du TPE en attente (Ctrl+T)" Command="{Binding BeginPendingAnswerCommand}"
                    IsVisible="{Binding CanAnswerCurrentPending}" />
          </Grid>
        </StackPanel>

        <!-- Tableau -->
        <Border Classes="card" Padding="0" ClipToBounds="True">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="12,7" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="30,98,112,*,104,100,*,112,58" ColumnSpacing="8">
                <TextBlock Grid.Column="1" Classes="label" Text="Ticket" />
                <TextBlock Grid.Column="2" Classes="label" Text="Date" />
                <TextBlock Grid.Column="3" Classes="label" Text="Client" />
                <TextBlock Grid.Column="4" Classes="label number" Text="Montant dû" />
                <TextBlock Grid.Column="5" Classes="label" Text="Statut" />
                <TextBlock Grid.Column="6" Classes="label" Text="Employé" />
                <TextBlock Grid.Column="7" Classes="label" Text="Réglé le" />
                <TextBlock Grid.Column="8" Classes="label" Text="Moyen" />
              </Grid>
            </Border>
            <Grid>
              <TextBlock x:Name="EmptyTableLabel" Classes="emptyState" Text="Aucun ticket dans ce filtre" IsVisible="{Binding !HasRows}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <ListBox x:Name="RowsList" ItemsSource="{Binding Rows}" SelectedItem="{Binding CurrentRow}" Background="Transparent"
                       Focusable="False">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="12,6" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:ReceivableRowViewModel">
                    <Grid ColumnDefinitions="30,98,112,*,104,100,*,112,58" ColumnSpacing="8">
                      <Button Classes="check" Classes.checked="{Binding IsChecked}" IsVisible="{Binding IsOpen}"
                              Command="{Binding $parent[UserControl].((local:CashViewModel)DataContext).ToggleCommand}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="✓" FontWeight="Bold" FontSize="14" IsVisible="{Binding IsChecked}" />
                      </Button>
                      <TextBlock Grid.Column="1" Classes="cell" Text="{Binding TicketNumber}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Classes="cell label" Text="{Binding DateText}" />
                      <TextBlock Grid.Column="3" Classes="cell" Text="{Binding CustomerName}" ToolTip.Tip="{Binding CustomerName}" />
                      <TextBlock Grid.Column="4" Classes="number" Text="{Binding AmountText}" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock Grid.Column="5" Classes="cell" Classes.pendingCard="{Binding IsCardPending}" Text="{Binding StatusText}" />
                      <TextBlock Grid.Column="6" Classes="cell" Text="{Binding EmployeeName}" />
                      <TextBlock Grid.Column="7" Classes="cell label" Text="{Binding SettledAtText}" />
                      <TextBlock Grid.Column="8" Classes="cell" Text="{Binding MethodText}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </DockPanel>
        </Border>
      </DockPanel>
    </Grid>

    <!-- ==================== Session de caisse ==================== -->
    <Grid Grid.Row="1" x:Name="SessionPanel" IsVisible="{Binding IsSessionTab}" Margin="16,10,16,12"
          ColumnDefinitions="*,*" ColumnSpacing="14">

      <StackPanel Spacing="10">
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Caisse de ce poste" />
            <TextBlock x:Name="CashStateLabel" Text="{Binding CashStateText}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock x:Name="CashOpenedLabel" Text="{Binding CashOpenedText}" IsVisible="{Binding IsCashOpen}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCashOpen}">
              <TextBlock Text="Fond de caisse" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="CashFloatLabel" Classes="number" FontWeight="SemiBold" Text="{Binding CashFloatText}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Ouverture -->
        <Border x:Name="OpeningPanel" Classes="card" IsVisible="{Binding CanShowOpening}">
          <StackPanel Spacing="10">
            <TextBlock Classes="label" Text="Fond de caisse compté, en dinars (0 si la caisse est vide)" />
            <TextBox x:Name="OpeningFloatBox" Text="{Binding OpeningFloatText}" FontSize="22" Padding="12,10" TextAlignment="Right"
                     IsEnabled="{Binding !IsConfirmingOpening}" />
            <Button Classes="primary step" Content="Valider le fond de caisse (Entrée)" Command="{Binding RequestCashOpeningCommand}"
                    IsVisible="{Binding !IsConfirmingOpening}" />
            <Border x:Name="OpeningConfirmationPanel" Classes="warning" IsVisible="{Binding IsConfirmingOpening}">
              <StackPanel Spacing="10">
                <TextBlock Text="Ouvrir la caisse avec ce fond de caisse ?" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="OpeningConfirmationLabel" Classes="big number" Text="{Binding OpeningFloatDisplayText}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <Button Classes="quiet step" Content="Corriger (Échap)" Command="{Binding CancelCashOpeningCommand}" />
                  <Button Grid.Column="1" Classes="primary step" Content="Ouvrir (Entrée)" Command="{Binding ConfirmCashOpeningCommand}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="warning" IsVisible="{Binding IsCashClosed}">
          <TextBlock Text="Aucune vente ni aucun règlement n'est possible tant que la caisse de ce poste est fermée."
                     TextWrapping="Wrap" FontWeight="Medium" />
        </Border>

        <!-- Entrées et sorties d'espèces -->
        <Grid x:Name="MovementButtons" ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding CanShowMovements}">
          <Button x:Name="CashInButton" Classes="quiet pay" HorizontalAlignment="Stretch" Command="{Binding BeginCashInCommand}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Classes="key"><TextBlock Text="{Binding CashInKeyLabel}" FontSize="13" FontWeight="Bold" /></Border>
              <TextBlock Grid.Column="1" Text="Entrée d'espèces" VerticalAlignment="Center" FontSize="15" />
            </Grid>
          </Button>
          <Button Grid.Column="1" x:Name="CashOutButton" Classes="quiet pay" HorizontalAlignment="Stretch" Command="{Binding BeginCashOutCommand}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Classes="key"><TextBlock Text="{Binding CashOutKeyLabel}" FontSize="13" FontWeight="Bold" /></Border>
              <TextBlock Grid.Column="1" Text="Sortie d'espèces" VerticalAlignment="Center" FontSize="15" />
            </Grid>
          </Button>
        </Grid>

        <!-- Fermeture de la caisse -->
        <Button x:Name="CloseRegisterButton" Classes="quiet pay" HorizontalAlignment="Stretch" Command="{Binding BeginCloseRegisterCommand}"
                IsVisible="{Binding CanShowCloseRegister}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Classes="key"><TextBlock Text="{Binding CloseKeyLabel}" FontSize="13" FontWeight="Bold" /></Border>
            <TextBlock Grid.Column="1" Text="Fermer la caisse — compter les espèces" VerticalAlignment="Center" FontSize="15" />
          </Grid>
        </Button>

        <Border Classes="message error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock x:Name="SessionErrorLabel" Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontWeight="Medium" />
        </Border>
        <Border Classes="message info" IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock x:Name="SessionInfoLabel" Text="{Binding InfoMessage}" TextWrapping="Wrap" FontWeight="Medium" />
        </Border>
      </StackPanel>

      <!-- Résumé de session -->
      <Border Grid.Column="1" Classes="card" VerticalAlignment="Top" IsVisible="{Binding IsCashOpen}">
        <Grid>
          <TextBlock Classes="emptyState" Text="Vos droits ne permettent pas de consulter les rapports de caisse."
                     IsVisible="{Binding CannotViewReports}" />
          <StackPanel x:Name="SummaryPanel" Spacing="4" IsVisible="{Binding CanShowSummary}">
            <TextBlock Text="Résumé de la session" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding SummaryLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:SummaryLine">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,3">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="label" Text="{Binding Note}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="number" Text="{Binding Amount}" MinWidth="120" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Background="{StaticResource TurquoiseSoftBrush}" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="ESPÈCES ATTENDUES DANS LE TIROIR" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" x:Name="ExpectedCashLabel" Classes="big number" FontSize="26" Text="{Binding ExpectedCashText}" />
              </Grid>
            </Border>
            <TextBlock x:Name="PendingCardLabel" Classes="stepError" Text="{Binding PendingCardText}" IsVisible="{Binding HasPendingCard}" />
            <TextBlock Classes="label" TextWrapping="Wrap"
                       Text="Les règlements d'impayés sont de la trésorerie du jour, pas du chiffre d'affaires. Un paiement par carte en attente n'est compté nulle part." />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ==================== Clôture ==================== -->
    <Grid Grid.Row="1" x:Name="ClosingPanel" IsVisible="{Binding IsClosingTab}" RowDefinitions="Auto,Auto,*">

      <Border Grid.RowSpan="3" Classes="card empty" IsVisible="{Binding CannotViewReports}">
        <StackPanel Spacing="8">
          <TextBlock Classes="emptyTitle" Text="Clôture quotidienne" />
          <TextBlock x:Name="NoReportsRightLabel" Classes="emptyState" Text="{x:Static local:CashViewModel.NoReportsViewRight}" />
        </StackPanel>
      </Border>

      <!-- Titre et actions -->
      <Grid Margin="16,10,16,0" ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding Rights.CanViewReports}">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="DayTitleLabel" Text="{Binding DayTitle}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"
                     IsVisible="{Binding IsDayMode}" />
          <TextBlock Text="Historique des clôtures" FontSize="19" FontWeight="Bold" IsVisible="{Binding IsHistoryMode}" />
          <TextBlock x:Name="OpenedClosureTitleLabel" Text="{Binding OpenedClosureTitle}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"
                     IsVisible="{Binding IsReportMode}" />
          <TextBlock x:Name="OpenedClosureByLabel" Classes="label" Text="{Binding OpenedClosureByText}" IsVisible="{Binding IsReportMode}" />
          <TextBlock Classes="label" Text="↑ ↓ : faire défiler · Ctrl+R : relire" IsVisible="{Binding IsDayMode}" />
          <TextBlock Classes="label" Text="↑ ↓ : choisir · Entrée : ouvrir le rapport figé · Échap : journée en cours"
                     IsVisible="{Binding IsHistoryMode}" TextWrapping="Wrap" />
          <TextBlock Classes="label" Text="↑ ↓ : faire défiler · Échap : revenir" IsVisible="{Binding IsReportMode}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="HistoryButton" Classes="quiet tab" Command="{Binding ToggleHistoryCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="key"><TextBlock Text="{Binding HistoryKeyLabel}" FontSize="12" FontWeight="Bold" /></Border>
              <TextBlock Text="{Binding HistoryKeyText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="ForcedCloseButton" Classes="refuse tab" Command="{Binding BeginForcedCloseCommand}">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="CanShowForcedClose" />
                <Binding Path="IsDayMode" />
              </MultiBinding>
            </Button.IsVisible>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="key"><TextBlock Text="{Binding ForcedCloseKeyLabel}" FontSize="12" FontWeight="Bold" /></Border>
              <TextBlock Text="Clôture forcée" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="CloseDayButton" Classes="primary tab" Command="{Binding BeginCloseDayCommand}" IsEnabled="{Binding CanCloseDay}">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="CanShowCloseDay" />
                <Binding Path="IsDayMode" />
              </MultiBinding>
            </Button.IsVisible>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="key"><TextBlock Text="{Binding CloseKeyLabel}" FontSize="12" FontWeight="Bold" /></Border>
              <TextBlock Text="Clôturer la journée" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Messages -->
      <StackPanel Grid.Row="1" Margin="16,8,16,0" Spacing="6" IsVisible="{Binding Rights.CanViewReports}">
        <Border Classes="message error" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock x:Name="ClosingErrorLabel" Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontWeight="Medium" />
        </Border>
        <Border Classes="message info" IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock x:Name="ClosingInfoLabel" Text="{Binding InfoMessage}" TextWrapping="Wrap" FontWeight="Medium" />
        </Border>
      </StackPanel>

      <!-- Journée en cours -->
      <ScrollViewer Grid.Row="2" x:Name="DayScroll" Margin="16,8,4,12" Padding="0,0,12,0" Focusable="False">
        <ScrollViewer.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsDayMode" />
            <Binding Path="HasDayStatus" />
            <Binding Path="Rights.CanViewReports" />
          </MultiBinding>
        </ScrollViewer.IsVisible>
        <StackPanel Spacing="10">
          <Border Classes="card" Padding="14,10">
            <StackPanel Spacing="4">
              <TextBlock x:Name="DayStateLabel" Text="{Binding DayStateText}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                         Classes.pendingCard="{Binding !IsDayReady}" />
              <TextBlock x:Name="LastClosedLabel" Classes="label" Text="{Binding LastClosedText}" />
              <TextBlock x:Name="PendingOfflineLabel" Classes="pendingCard" Text="{Binding PendingOfflineText}" TextWrapping="Wrap"
                         IsVisible="{Binding HasPendingOffline}" />
            </StackPanel>
          </Border>

          <Border x:Name="DayBlockersPanel" Classes="warning" IsVisible="{Binding IsDayBlocked}">
            <StackPanel Spacing="8">
              <TextBlock Text="Ce qui bloque la clôture" FontSize="17" FontWeight="Bold" />
              <ItemsControl x:Name="DayBlockersList" ItemsSource="{Binding DayBlockers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:BlockerRowViewModel">
                    <StackPanel Spacing="1" Margin="0,4">
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                      <TextBlock Classes="label" Text="{Binding Hint}" TextWrapping="Wrap" IsVisible="{Binding HasHint}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <StackPanel Spacing="2">
            <TextBlock Text="Aperçu des totaux — NON FIGÉ" FontSize="15" FontWeight="Bold" />
            <TextBlock Classes="label" TextWrapping="Wrap"
                       Text="Ces montants changent tant que la journée n'est pas clôturée. Seul le rapport de clôture est figé." />
          </StackPanel>
          <local:ClosureReportPanel x:Name="DayPreviewPanel" DataContext="{Binding DayPreview}" />
        </StackPanel>
      </ScrollViewer>

      <!-- Historique -->
      <Border Grid.Row="2" Classes="card" Margin="16,8,16,12" Padding="0">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsHistoryMode" />
            <Binding Path="Rights.CanViewReports" />
          </MultiBinding>
        </Border.IsVisible>
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="1.1*,2.4*,1.4*,1.4*,1.4*,1.6*,0.9*" ColumnSpacing="8" Margin="14,10,14,6">
            <TextBlock Classes="label" Text="Journée" />
            <TextBlock Grid.Column="1" Classes="label" Text="Clôturée le — par" />
            <TextBlock Grid.Column="2" Classes="label number" Text="CA net" />
            <TextBlock Grid.Column="3" Classes="label number" Text="Espèces" />
            <TextBlock Grid.Column="4" Classes="label number" Text="TPE" />
            <TextBlock Grid.Column="5" Classes="label number" Text="Écart" />
          </Grid>
          <TextBlock DockPanel.Dock="Top" Classes="emptyState" Margin="14,10" Text="Aucune clôture." IsVisible="{Binding !HasHistory}" />
          <ListBox x:Name="HistoryList" ItemsSource="{Binding HistoryRows}" SelectedItem="{Binding SelectedHistoryRow}"
                   Background="Transparent" Focusable="False">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Padding" Value="14,8" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:ClosureHistoryRowViewModel">
                <Grid ColumnDefinitions="1.1*,2.4*,1.4*,1.4*,1.4*,1.6*,0.9*" ColumnSpacing="8">
                  <TextBlock Classes="cell" Text="{Binding DateText}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Classes="cell" Text="{Binding ClosedText}" />
                  <TextBlock Grid.Column="2" Classes="cell number" Text="{Binding NetRevenueText}" />
                  <TextBlock Grid.Column="3" Classes="cell number" Text="{Binding NetCashText}" />
                  <TextBlock Grid.Column="4" Classes="cell number" Text="{Binding NetCardText}" />
                  <TextBlock Grid.Column="5" Classes="cell number" Text="{Binding DifferenceText}"
                             Classes.pendingCard="{Binding IsDifferenceAlert}" />
                  <TextBlock Grid.Column="6" Classes="cell pendingCard" Text="{Binding ForcedText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Rapport figé -->
      <ScrollViewer Grid.Row="2" x:Name="ReportScroll" Margin="16,8,4,12" Padding="0,0,12,0" Focusable="False">
        <ScrollViewer.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsReportMode" />
            <Binding Path="HasOpenedClosure" />
          </MultiBinding>
        </ScrollViewer.IsVisible>
        <StackPanel Spacing="10">
          <Border x:Name="ForcedReportPanel" Classes="warning" IsVisible="{Binding IsOpenedClosureForced}">
            <StackPanel Spacing="4">
              <TextBlock x:Name="ForcedReportLabel" Text="{Binding OpenedClosureWarning}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock x:Name="ForcedReasonLabel" Text="{Binding OpenedClosureReasonText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <local:ClosureReportPanel x:Name="OpenedReportPanel" DataContext="{Binding OpenedReport}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ==================== Étapes du règlement ==================== -->
    <Border Grid.Row="0" Grid.RowSpan="2" x:Name="StepOverlay" Background="#99111111" IsVisible="{Binding IsStepOpen}" ZIndex="10">
      <Border Classes="card" Width="600" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>

          <!-- Choix du client -->
          <StackPanel x:Name="ChooseCustomerPanel" Spacing="10"
                      IsVisible="{Binding Step, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SettlementStep.ChooseCustomer}}">
            <TextBlock Classes="stepTitle" Text="Plusieurs clients correspondent" />
            <Border Classes="card" Padding="0" MaxHeight="260">
              <ListBox x:Name="CustomerList" ItemsSource="{Binding CustomerResults}" SelectedItem="{Binding SelectedCustomerResult}"
                       Background="Transparent" Focusable="False">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="12,8" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="contracts:CustomerSummary">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="label" Text="{Binding Phone}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Classes="quiet step" Content="Annuler (Échap)" Command="{Binding CancelStepCommand}" />
              <Button Grid.Column="1" Classes="primary step" Content="Voir ses tickets (Entrée)" Command="{Binding ChooseCustomerCommand}" />
            </Grid>
          </StackPanel>

          <!-- Espèces : montant reçu -->
          <StackPanel x:Name="CashAmountPanel" Spacing="10"
                      IsVisible="{Binding Step, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SettlementStep.CashAmount}}">
            <TextBlock Classes="stepTitle" Text="Règlement en espèces" />
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Client" />
              <TextBlock x:Name="CashCustomerLabel" Text="{Binding CheckoutCustomerText}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Classes="label" Text="{Binding CheckoutTicketsText}" TextWrapping="Wrap" MaxHeight="96" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Montant dû (non modifiable)" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="CashTotalLabel" Classes="big number" Text="{Binding CheckoutTotalText}" />
            </Grid>
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="Montant reçu (laisser vide si le client donne le montant exact)" />
              <TextBox x:Name="ReceivedBox" Text="{Binding ReceivedText}" FontSize="24" Padding="12,10" TextAlignment="Right" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Monnaie à rendre" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="ChangePreviewLabel" Classes="big number" Text="{Binding ChangePreviewText}" />
            </Grid>
            <TextBlock x:Name="CashErrorLabel" Classes="stepError" Text="{Binding StepError}"
                       IsVisible="{Binding StepError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Classes="quiet step" Content="Annuler (Échap)" Command="{Binding CancelStepCommand}" />
              <Button Grid.Column="1" Classes="primary step" Content="Valider (Entrée)" Command="{Binding ValidateCashAmountCommand}" />
            </Grid>
            <TextBlock Classes="label" Text="Rien n'est encore enregistré : la confirmation vient ensuite." TextWrapping="Wrap" />
          </StackPanel>

          <!-- Espèces : confirmation -->
          <StackPanel x:Name="CashConfirmPanel" Spacing="10"
                      IsVisible="{Binding Step, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SettlementStep.CashConfirm}}">
            <TextBlock Classes="stepTitle" Text="Espèces — confirmer le règlement" />
            <TextBlock x:Name="CashConfirmCustomerLabel" Text="{Binding CheckoutCustomerText}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Classes="label" Text="{Binding CheckoutTicketsText}" TextWrapping="Wrap" MaxHeight="96" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Montant dû" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="CashConfirmTotalLabel" Classes="number" FontSize="20" FontWeight="SemiBold"
                         Text="{Binding CheckoutTotalText}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Montant reçu" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="AmountReceivedLabel" Classes="number" FontSize="20" FontWeight="SemiBold"
                         Text="{Binding AmountReceivedText}" />
            </Grid>
            <Border Background="{StaticResource TurquoiseSoftBrush}" CornerRadius="8" Padding="16,8">
              <StackPanel>
                <TextBlock Text="MONNAIE À RENDRE" FontWeight="SemiBold" />
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" Height="56">
                  <TextBlock x:Name="ChangeDueLabel" Classes="huge" Text="{Binding ChangeDueText}" />
                </Viewbox>
              </StackPanel>
            </Border>
            <TextBlock Classes="label" Text="Envoi en cours…" IsVisible="{Binding IsSending}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Classes="quiet step" Content="Modifier (Échap)" Command="{Binding CancelStepCommand}" />
              <Button Grid.Column="1" Classes="primary step" Content="Encaisser (Entrée)" Command="{Binding ConfirmSettlementCommand}" />
            </Grid>
          </StackPanel>

          <!-- TPE : confirmation -->
          <StackPanel x:Name="CardConfirmPanel" Spacing="10"
                      IsVisible="{Binding Step, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SettlementStep.CardConfirm}}">
            <TextBlock Classes="stepTitle" Text="TPE — lancer le paiement par carte" />
            <TextBlock x:Name="CardCustomerLabel" Text="{Binding CheckoutCustomerText}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Classes="label" Text="{Binding CheckoutTicketsText}" TextWrapping="Wrap" MaxHeight="96" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Montant dû (non modifiable)" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="CardTotalLabel" Classes="big number" Text="{Binding CheckoutTotalText}" />
            </Grid>
            <TextBlock TextWrapping="Wrap"
                       Text="Le règlement sera enregistré « en attente ». La dette ne sera soldée qu'après « Paiement accepté »." />
            <TextBlock Classes="label" Text="Envoi en cours…" IsVisible="{Binding IsSending}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Classes="quiet step" Content="Annuler (Échap)" Command="{Binding CancelStepCommand}" />
              <Button Grid.Column="1" Classes="primary step" Content="Lancer le paiement (Entrée)" Command="{Binding ConfirmSettlementCommand}" />
            </Grid>
          </StackPanel>

          <!-- TPE : réponse du terminal -->
          <StackPanel x:Name="CardPendingPanel" Spacing="10"
                      IsVisible="{Binding Step, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SettlementStep.CardPending}}">
            <TextBlock Classes="stepTitle" Text="Paiement par carte en attente" />
            <TextBlock x:Name="PendingSettlementLabel" Classes="big" Text="{Binding PendingSettlementText}" FontSize="22" TextWrapping="Wrap" />
            <TextBlock Classes="label" Text="{Binding CheckoutTicketsText}" TextWrapping="Wrap" MaxHeight="96" />
            <TextBlock TextWrapping="Wrap" Text="Encaissez ce montant sur le terminal, puis indiquez sa réponse." />
            <Button x:Name="CardAcceptedButton" Classes="primary pay" HorizontalAlignment="Stretch" Command="{Binding AcceptCardCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="key" MinWidth="34">
                  <TextBlock Text="{Binding CardAcceptedKeyLabel}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="Paiement accepté" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="CardRefusedButton" Classes="refuse pay" HorizontalAlignment="Stretch" Command="{Binding RefuseCardCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="key" MinWidth="34">
                  <TextBlock Text="{Binding CardRefusedKeyLabel}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="Paiement refusé — la dette reste ouverte" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <TextBlock Classes="label" TextWrapping="Wrap" Text="Entrée ne répond pas à la place du terminal." />
            <TextBlock Classes="label" Text="Envoi en cours…" IsVisible="{Binding IsSending}" />
            <TextBlock x:Name="CardErrorLabel" Classes="stepError" Text="{Binding StepError}"
                       IsVisible="{Binding StepError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <!-- Envoi sans réponse -->
          <StackPanel x:Name="UnconfirmedPanel" Spacing="12"
                      IsVisible="{Binding Step, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SettlementStep.Unconfirmed}}">
            <Border Classes="warning">
              <TextBlock x:Name="UnconfirmedLabel" Text="{x:Static local:CashViewModel.UnconfirmedTitle}" FontSize="20" FontWeight="Bold"
                         TextWrapping="Wrap" />
            </Border>
            <TextBlock TextWrapping="Wrap"
                       Text="Le serveur n'a pas répondu : on ne sait pas si le règlement est enregistré. Réessayer renvoie exactement le même règlement ; il ne peut pas être encaissé deux fois." />
            <TextBlock Classes="label" Text="Envoi en cours…" IsVisible="{Binding IsSending}" />
            <Button x:Name="RetryButton" Classes="primary step" Content="Réessayer (Entrée)" Command="{Binding RetrySettlementCommand}" />
          </StackPanel>

          <!-- Récapitulatif -->
          <StackPanel x:Name="DonePanel" Spacing="10"
                      IsVisible="{Binding Step, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SettlementStep.Done}}">
            <TextBlock Classes="stepTitle" Text="Règlement enregistré" />
            <TextBlock x:Name="DoneTitleLabel" Text="{Binding DoneTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="DoneTicketsLabel" Classes="label" Text="{Binding DoneTicketsText}" TextWrapping="Wrap" MaxHeight="96" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Montant encaissé" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="DoneAmountLabel" Classes="big number" Text="{Binding DoneAmountText}" />
            </Grid>
            <Border Background="{StaticResource TurquoiseSoftBrush}" CornerRadius="8" Padding="16,8" IsVisible="{Binding IsDoneCash}">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="MONNAIE À RENDRE" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="label" Text="{Binding DoneReceivedText}" VerticalAlignment="Center" />
                </Grid>
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" Height="56">
                  <TextBlock x:Name="DoneChangeLabel" Classes="huge" Text="{Binding DoneChangeText}" />
                </Viewbox>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource TurquoiseSoftBrush}" CornerRadius="8" Padding="16,10" IsVisible="{Binding IsDoneCard}">
              <TextBlock x:Name="DoneCardLabel" Text="TPE — paiement accepté" FontSize="18" FontWeight="SemiBold" />
            </Border>
            <Button x:Name="DoneButton" Classes="primary step" Content="Retour au tableau (Entrée)" Command="{Binding FinishCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- ==================== Étapes des mouvements d'espèces ==================== -->
    <Border Grid.Row="0" Grid.RowSpan="2" x:Name="SessionStepOverlay" Background="#99111111" IsVisible="{Binding IsSessionStepOpen}"
            ZIndex="10">
      <Border Classes="card" Width="560" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <StackPanel x:Name="MovementInputPanel" Spacing="10"
                      IsVisible="{Binding SessionStep, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SessionStep.MovementInput}}">
            <TextBlock Classes="stepTitle" Text="{Binding MovementTitle}" />
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="Montant (virgule ou point)" />
              <TextBox x:Name="MovementAmountBox" Text="{Binding MovementAmountText}" FontSize="22" Padding="12,10" TextAlignment="Right" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="Motif (obligatoire)" />
              <TextBox x:Name="MovementReasonBox" Text="{Binding MovementReason}" FontSize="17" Padding="12,9" MaxLength="500" />
            </StackPanel>
            <TextBlock x:Name="MovementErrorLabel" Classes="stepError" Text="{Binding SessionStepError}"
                       IsVisible="{Binding SessionStepError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Classes="quiet step" Content="Annuler (Échap)" Command="{Binding CancelSessionStepCommand}" />
              <Button Grid.Column="1" Classes="primary step" Content="Valider (Entrée)" Command="{Binding ValidateMovementCommand}" />
            </Grid>
            <TextBlock Classes="label" Text="Rien n'est encore enregistré : la confirmation vient ensuite." />
          </StackPanel>

          <StackPanel x:Name="MovementConfirmPanel" Spacing="12"
                      IsVisible="{Binding SessionStep, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SessionStep.MovementConfirm}}">
            <TextBlock Classes="stepTitle" Text="{Binding MovementTitle}" />
            <TextBlock x:Name="MovementAmountLabel" Classes="big number" HorizontalAlignment="Left" Text="{Binding MovementAmountDisplayText}" />
            <TextBlock x:Name="MovementConfirmLabel" Text="{Binding MovementConfirmText}" TextWrapping="Wrap" />
            <TextBlock Classes="label" Text="Envoi en cours…" IsVisible="{Binding IsSending}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Classes="quiet step" Content="Modifier (Échap)" Command="{Binding CancelSessionStepCommand}" />
              <Button Grid.Column="1" Classes="primary step" Content="Enregistrer (Entrée)" Command="{Binding ConfirmMovementCommand}" />
            </Grid>
          </StackPanel>

          <StackPanel x:Name="MovementUnconfirmedPanel" Spacing="12"
                      IsVisible="{Binding SessionStep, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SessionStep.MovementUnconfirmed}}">
            <Border Classes="warning">
              <TextBlock Text="{x:Static local:CashViewModel.MovementUnconfirmedTitle}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
            </Border>
            <TextBlock TextWrapping="Wrap"
                       Text="Le serveur n'a pas répondu : on ne sait pas si le mouvement est enregistré. Réessayer renvoie exactement le même mouvement ; il ne peut pas être compté deux fois." />
            <TextBlock Classes="label" Text="Envoi en cours…" IsVisible="{Binding IsSending}" />
            <Button Classes="primary step" Content="Réessayer (Entrée)" Command="{Binding RetryMovementCommand}" />
          </StackPanel>

          <!-- Fermeture : comptage -->
          <StackPanel x:Name="CloseCountPanel" Spacing="10"
                      IsVisible="{Binding SessionStep, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SessionStep.CloseCount}}">
            <TextBlock Classes="stepTitle" Text="Fermer la caisse" />
            <TextBlock x:Name="CloseRegisterLabel" Text="{Binding CloseRegisterName}" FontSize="18" FontWeight="SemiBold" />
            <StackPanel Spacing="4">
              <TextBlock Classes="label" TextWrapping="Wrap"
                         Text="Comptez les espèces du tiroir (fond de caisse compris) et saisissez le total, en dinars." />
              <TextBox x:Name="CountedCashBox" Text="{Binding CountedCashText}" FontSize="24" Padding="12,10" TextAlignment="Right" />
            </StackPanel>
            <TextBlock x:Name="CloseCountErrorLabel" Classes="stepError" Text="{Binding SessionStepError}"
                       IsVisible="{Binding SessionStepError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Classes="quiet step" Content="Annuler (Échap)" Command="{Binding CancelSessionStepCommand}" />
              <Button Grid.Column="1" Classes="primary step" Content="Valider (Entrée)" Command="{Binding ValidateCountedCashCommand}" />
            </Grid>
            <TextBlock Classes="label" Text="Rien n'est encore enregistré : la confirmation vient ensuite." />
          </StackPanel>

          <!-- Fermeture : confirmation -->
          <StackPanel x:Name="CloseConfirmPanel" Spacing="12"
                      IsVisible="{Binding SessionStep, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SessionStep.CloseConfirm}}">
            <TextBlock Classes="stepTitle" Text="Fermer la caisse avec ce comptage ?" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Espèces comptées" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="CountedCashConfirmLabel" Classes="big number" Text="{Binding CountedCashDisplayText}" />
            </Grid>
            <Border Classes="warning">
              <TextBlock TextWrapping="Wrap" FontWeight="Medium"
                         Text="Après la fermeture, plus aucune vente, aucun règlement ni mouvement d'espèces sur cette caisse avant sa réouverture. Le comptage ne pourra plus être modifié." />
            </Border>
            <TextBlock Classes="label" Text="Envoi en cours…" IsVisible="{Binding IsSending}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Classes="quiet step" Content="Corriger (Échap)" Command="{Binding CancelSessionStepCommand}" />
              <Button Grid.Column="1" Classes="primary step" Content="Fermer la caisse (Entrée)" Command="{Binding ConfirmCloseRegisterCommand}" />
            </Grid>
          </StackPanel>

          <!-- Fermeture : sans réponse -->
          <StackPanel x:Name="CloseUnconfirmedPanel" Spacing="12"
                      IsVisible="{Binding SessionStep, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SessionStep.CloseUnconfirmed}}">
            <Border Classes="warning">
              <TextBlock Text="{x:Static local:CashViewModel.CloseUnconfirmedTitle}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
            </Border>
            <TextBlock TextWrapping="Wrap"
                       Text="Le serveur n'a pas répondu : on ne sait pas si la caisse est fermée. Réessayer renvoie exactement le même comptage ; la caisse ne peut pas être fermée deux fois." />
            <TextBlock Classes="label" Text="Envoi en cours…" IsVisible="{Binding IsSending}" />
            <Button Classes="primary step" Content="Réessayer (Entrée)" Command="{Binding RetryCloseRegisterCommand}" />
          </StackPanel>

          <!-- Fermeture : refusée -->
          <StackPanel x:Name="CloseBlockedPanel" Spacing="10"
                      IsVisible="{Binding SessionStep, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SessionStep.CloseBlocked}}">
            <TextBlock Classes="stepTitle" Text="La caisse ne peut pas être fermée" />
            <Border Classes="message error">
              <TextBlock x:Name="CloseBlockedLabel" Text="{Binding CloseBlockedMessage}" TextWrapping="Wrap" FontWeight="Medium" />
            </Border>
            <ScrollViewer MaxHeight="220" IsVisible="{Binding HasCloseBlockers}">
              <ItemsControl x:Name="CloseBlockersList" ItemsSource="{Binding CloseBlockers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:BlockerRowViewModel">
                    <StackPanel Spacing="1" Margin="0,4">
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                      <TextBlock Classes="label" Text="{Binding Hint}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="CloseBlockedHelpLabel" TextWrapping="Wrap" Text="{x:Static local:CashViewModel.CloseBlockedHelp}" />
            <Button Classes="primary step" Content="Compris (Entrée)" Command="{Binding FinishCloseRegisterCommand}" />
          </StackPanel>

          <!-- Fermeture : rapport de session -->
          <StackPanel x:Name="CloseDonePanel" Spacing="8"
                      IsVisible="{Binding SessionStep, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:SessionStep.CloseDone}}">
            <TextBlock Classes="stepTitle" Text="Caisse fermée — rapport de session" />
            <StackPanel DataContext="{Binding ClosedSessionReport}" x:DataType="local:SessionReportViewModel" Spacing="6">
              <TextBlock x:Name="ClosedSessionTitleLabel" Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Classes="label" Text="{Binding ClosedText}" />
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:ReportLine">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,1">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Classes="label" Text="{Binding Note}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="number" Text="{Binding Amount}" MinWidth="120" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="{StaticResource TurquoiseSoftBrush}" CornerRadius="8" Padding="14,8">
                <StackPanel Spacing="2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Espèces attendues" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="ClosedExpectedLabel" Classes="number" FontSize="18" FontWeight="Bold" Text="{Binding ExpectedText}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Espèces comptées" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="ClosedCountedLabel" Classes="number" FontSize="18" FontWeight="Bold" Text="{Binding CountedText}" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border x:Name="ClosedDifferencePanel" CornerRadius="8" Padding="14,8" Background="{StaticResource TurquoiseSoftBrush}"
                      Classes.warning="{Binding IsDifferenceAlert}">
                <StackPanel Spacing="2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="ÉCART" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="ClosedDifferenceLabel" Classes="big number" FontSize="26" Text="{Binding DifferenceText}"
                               Classes.pendingCard="{Binding IsDifferenceAlert}" />
                  </Grid>
                  <TextBlock Classes="label" Text="{Binding DifferenceExplanation}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
            <Button x:Name="CloseDoneButton" Classes="primary step" Content="Terminé (Entrée)" Command="{Binding FinishCloseRegisterCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- ==================== Étapes de la clôture de la journée ==================== -->
    <Border Grid.Row="0" Grid.RowSpan="2" x:Name="ClosingStepOverlay" Background="#99111111" IsVisible="{Binding IsClosingStepOpen}"
            ZIndex="10">
      <Border Classes="card" Width="600" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <!-- Clôture forcée : motif -->
          <StackPanel x:Name="ForceReasonPanel" Spacing="10"
                      IsVisible="{Binding ClosingStep, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:ClosingStep.ForceReason}}">
            <TextBlock Classes="stepTitle" Text="Clôture forcée — procédure exceptionnelle" />
            <Border Classes="warning">
              <TextBlock x:Name="ForcedWarningLabel" Text="{x:Static local:CashViewModel.ForcedWarningText}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="{Binding PendingOfflineText}" TextWrapping="Wrap" />
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="Motif (obligatoire)" />
              <TextBox x:Name="ForceReasonBox" Text="{Binding ForceReason}" FontSize="17" Padding="12,9" MaxLength="500" />
            </StackPanel>
            <TextBlock x:Name="ForceReasonErrorLabel" Classes="stepError" Text="{Binding ClosingStepError}"
                       IsVisible="{Binding ClosingStepError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Classes="quiet step" Content="Annuler (Échap)" Command="{Binding CancelClosingStepCommand}" />
              <Button Grid.Column="1" Classes="primary step" Content="Valider le motif (Entrée)" Command="{Binding ValidateForceReasonCommand}" />
            </Grid>
            <TextBlock Classes="label" Text="Rien n'est encore enregistré : la confirmation vient ensuite." />
          </StackPanel>

          <!-- Confirmation forte -->
          <StackPanel x:Name="ClosingConfirmPanel" Spacing="12"
                      IsVisible="{Binding ClosingStep, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:ClosingStep.Confirm}}">
            <TextBlock Classes="stepTitle" Text="{Binding ClosingConfirmTitle}" />
            <TextBlock x:Name="ClosingDateLabel" Classes="big" Text="{Binding ClosingDateText}" />
            <Border Classes="warning">
              <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                         Text="Opération IRRÉVERSIBLE : la journée sera figée. Ses ventes, règlements et mouvements ne pourront plus en changer, et tout ce qui sera saisi ensuite appartiendra à la journée suivante." />
            </Border>
            <Border Classes="warning" IsVisible="{Binding IsForcedClosing}">
              <StackPanel Spacing="4">
                <TextBlock Text="{x:Static local:CashViewModel.ForcedWarningText}" TextWrapping="Wrap" />
                <TextBlock x:Name="ForceReasonConfirmLabel" Text="{Binding ForceReason, StringFormat='Motif : {0}'}" TextWrapping="Wrap"
                           FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <TextBlock Classes="label" TextWrapping="Wrap" Text="Entrée ne clôture pas : appuyez sur F10 pour clôturer définitivement." />
            <TextBlock Classes="label" Text="Envoi en cours…" IsVisible="{Binding IsSending}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Classes="quiet step" Content="Annuler (Échap)" Command="{Binding CancelClosingStepCommand}" />
              <Button Grid.Column="1" x:Name="ConfirmCloseDayButton" Classes="primary step" Content="Clôturer définitivement (F10)"
                      Command="{Binding ConfirmCloseDayCommand}" />
            </Grid>
          </StackPanel>

          <!-- Sans réponse -->
          <StackPanel x:Name="ClosingUnconfirmedPanel" Spacing="12"
                      IsVisible="{Binding ClosingStep, Converter={x:Static sales:EqualityConverter.Instance}, ConverterParameter={x:Static local:ClosingStep.Unconfirmed}}">
            <Border Classes="warning">
              <TextBlock Text="{x:Static local:CashViewModel.ClosingUnconfirmedTitle}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
            </Border>
            <TextBlock TextWrapping="Wrap"
                       Text="Le serveur n'a pas répondu : on ne sait pas si la journée est clôturée. Réessayer renvoie exactement la même clôture ; elle ne peut pas être faite deux fois." />
            <TextBlock Classes="label" Text="Envoi en cours…" IsVisible="{Binding IsSending}" />
            <Button Classes="primary step" Content="Réessayer (Entrée)" Command="{Binding RetryCloseDayCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
