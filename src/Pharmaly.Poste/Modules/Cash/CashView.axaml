<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Pharmaly.Poste.Modules.Cash"
             x:Class="Pharmaly.Poste.Modules.Cash.CashView"
             x:DataType="local:CashViewModel"
             Focusable="True">
  <!-- État vide : à remplacer par l'écran du module. -->
  <Border Classes="card empty">
    <StackPanel Spacing="8">
      <TextBlock Classes="emptyTitle" Text="Caisse" />
      <TextBlock x:Name="EmptyStateLabel" Classes="emptyState" Text="Module en cours de développement" />
      <TextBlock Classes="label" TextAlignment="Center" TextWrapping="Wrap"
                 Text="Aucune opération n'est possible ici pour l'instant." />
    </StackPanel>
  </Border>
</UserControl>
